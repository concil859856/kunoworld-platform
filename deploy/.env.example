# Copy to .env (git-ignored) and replace every CHANGE_ME. No value here is a real secret.
# Generate secrets with e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Passwords end up inside a database URL: stick to URL-safe characters (letters, digits, - _).

# ------------------------------------------------------------------ build
# Directory holding the platform, subnet and sdk checkouts side by side (relative to this file).
KUNO_BUILD_CONTEXT=../..
KUNO_IMAGE_TAG=local
# 1 until next.config.ts sets output: "standalone" (adds it inside the build stage only).
WEB_PATCH_STANDALONE=0

# ------------------------------------------------------------------ host ports (127.0.0.1 only)
GATEWAY_PORT=18080
WEB_PORT=13000
MINIO_CONSOLE_PORT=19001

# Baked into the website at build time; must be reachable from browsers AND the web container.
# The default relies on the gateway's gateway.localhost network alias; keep the port in step
# with GATEWAY_PORT.
KUNO_PUBLIC_API_URL=http://gateway.localhost:18080

# ------------------------------------------------------------------ Postgres
POSTGRES_DB=kuno
POSTGRES_USER=kuno
POSTGRES_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------ MinIO / S3
MINIO_ROOT_USER=kuno-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS
KUNO_S3_BUCKET=kuno-blobs
KUNO_S3_REGION=us-east-1
# The gateway's own least-privilege MinIO user (created by minio-setup).
KUNO_S3_ACCESS_KEY_ID=kuno-gateway
KUNO_S3_SECRET_ACCESS_KEY=CHANGE_ME_AT_LEAST_8_CHARS
# Lifecycle safety net: objects older than this are deleted even if the janitor missed them.
# Keep it above the gateway's blob retention (7 days).
KUNO_S3_EXPIRE_DAYS=8

# ------------------------------------------------------------------ gateway
KUNO_METRICS_TOKEN=CHANGE_ME
KUNO_LOG_FORMAT=json
KUNO_LOG_LEVEL=INFO
KUNO_SIGNUP_CREDIT_USD=5
KUNO_EMAIL_FROM=KunoWorld <signin@localhost>
# Empty: sign-in emails are written to the gateway's outbox directory instead of being sent.
KUNO_RESEND_API_KEY=

# ------------------------------------------------------------------ worker
KUNO_WORKER_PROFILES=ltx-2.5-fast,ltx-2.5-pro,h3-turbo,h3,h3-reference

# ------------------------------------------------------------------ Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local-compose

# Not set here on purpose: KUNO_ADMIN_TOKEN, KUNO_DEV_API_KEY, KUNO_VALIDATOR_API_KEY and
# KUNO_OWNER_PUBLIC_KEY come from the devkit service's dev.env in the kuno-keys volume.
