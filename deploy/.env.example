# Copy to .env (git-ignored) and replace every CHANGE_ME. No value here is a real secret.
# Generate secrets with e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Passwords end up inside a database URL: stick to URL-safe characters (letters, digits, - _).

# ------------------------------------------------------------------ build
# Directory holding the platform, subnet and sdk checkouts side by side (relative to this file).
KUNO_BUILD_CONTEXT=../..
KUNO_IMAGE_TAG=local
# 1 until next.config.ts sets output: "standalone" (adds it inside the build stage only).
WEB_PATCH_STANDALONE=0

# ------------------------------------------------------------------ host ports (127.0.0.1 only)
GATEWAY_PORT=18080
WEB_PORT=13000
MINIO_CONSOLE_PORT=19001

# Baked into the website at build time; must be reachable from browsers AND the web container.
# The default relies on the gateway's gateway.localhost network alias; keep the port in step
# with GATEWAY_PORT.
KUNO_PUBLIC_API_URL=http://gateway.localhost:18080

# ------------------------------------------------------------------ Postgres
POSTGRES_DB=kuno
POSTGRES_USER=kuno
POSTGRES_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------ blob storage (this stack: MinIO)
# Videos (Standard: encrypted at rest by the gateway; Private: ciphertext only the customer can open)
# stay until their owner deletes them. Never add an expiry lifecycle rule to this bucket.
MINIO_ROOT_USER=kuno-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS
KUNO_S3_BUCKET=kuno-blobs
KUNO_S3_REGION=us-east-1
# The gateway's own least-privilege MinIO user (created by minio-setup).
KUNO_S3_ACCESS_KEY_ID=kuno-gateway
KUNO_S3_SECRET_ACCESS_KEY=CHANGE_ME_AT_LEAST_8_CHARS

# ------------------------------------------------------------------ production: Cloudflare R2
# Production stores blobs on R2 and refuses to start with the local backend. These replace the
# MinIO values above in the gateway's environment (compose sets KUNO_S3_ENDPOINT_URL to MinIO):
#   KUNO_ENV=production
#   KUNO_BLOB_BACKEND=s3
#   KUNO_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   KUNO_S3_REGION=auto
#   KUNO_S3_BUCKET=kuno-blobs
#   KUNO_S3_ACCESS_KEY_ID=<R2 API token access key id, Object Read & Write on this bucket only>
#   KUNO_S3_SECRET_ACCESS_KEY=<R2 API token secret>
#   KUNO_STANDARD_STORAGE_KEY=<base64url of 32 random bytes; back it up separately>

# ------------------------------------------------------------------ gateway
KUNO_METRICS_TOKEN=CHANGE_ME
KUNO_LOG_FORMAT=json
KUNO_LOG_LEVEL=INFO
KUNO_SIGNUP_CREDIT_USD=5
KUNO_EMAIL_FROM=KunoWorld <signin@localhost>
# Empty: sign-in emails are written to the gateway's outbox directory instead of being sent.
KUNO_RESEND_API_KEY=

# ------------------------------------------------------------------ worker
KUNO_WORKER_PROFILES=ltx-2.5-fast,ltx-2.5-pro,h3-turbo,h3,h3-reference

# ------------------------------------------------------------------ Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local-compose

# Not set here on purpose: KUNO_DEV_API_KEY, KUNO_VALIDATOR_API_KEY and KUNO_OWNER_PUBLIC_KEY come
# from the devkit service's dev.env in the kuno-keys volume.
#
# Operators sign in by email. Grant the first admin once the gateway is up:
#   docker compose exec gateway kuno-gateway grant-role --email you@example.com --role admin
# The devkit's KUNO_ADMIN_TOKEN is break-glass only and ignored unless KUNO_ALLOW_ADMIN_TOKEN=1
# (never honoured with KUNO_ENV=production or KUNO_ATTESTATION=production). Leave it off.
